# Copia questo file in .env e compila i valori.
# In produzione (DigitalOcean) queste variabili vanno impostate come env vars dell'app.

# DATABASE — URL Postgres completo (Neon in produzione, Supabase da v0.2.0)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# SECURITY
# Firma dei token JWT di sessione merchant. Stringa lunga e casuale.
JWT_SECRET_KEY=

# Protegge gli endpoint amministrativi /api/merchant (header X-Admin-Key).
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SECRET_KEY=

# AUTH
# dev = accesso locale/test senza verifica (rifiutato se ENVIRONMENT=production); supabase = provider reale
AUTH_PROVIDER=dev
# development | production
ENVIRONMENT=development
# Solo AUTH_PROVIDER=dev: password di accesso dei merchant creati da scripts.seed_db
# (non è un segreto, serve solo in locale). Vuota = nessun accesso con password dev.
DEV_AUTH_PASSWORD=dev-password

# ECOLOGI (piantumazione alberi) — una sola chiave di piattaforma, paga il founder
# Ambiente REALE (addebita): usato solo con ECOLOGI_TEST_MODE=false
ECOLOGI_API_KEY=
ECOLOGI_BASE_URL=https://public.ecologi.com
# Ambiente di PROVA messo a disposizione da Ecologi (chiave e URL di test): usato con ECOLOGI_TEST_MODE=true
ECOLOGI_TEST_API_KEY=
ECOLOGI_TEST_BASE_URL=
# true → si usano chiave e URL di test + flag "test" (nessun addebito). Mettere false SOLO in produzione.
ECOLOGI_TEST_MODE=true
# Massimo alberi piantati in una chiusura mensile (oltre, close_period si ferma e chiede)
ECOLOGI_GLOBAL_MONTHLY_CAP=20

# LIVELLI DEL POOL — soglie di default (punti del mese); l'admin può fare override per negozio
TIER_BRONZE_POINTS=100
TIER_SILVER_POINTS=300
TIER_GOLD_POINTS=600
