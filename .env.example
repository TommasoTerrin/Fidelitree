# Copia questo file in .env e compila i valori.
# In produzione (DigitalOcean) queste variabili vanno impostate come env vars dell'app.

# DATABASE — URL Postgres completo (Neon in produzione, Supabase da v0.2.0)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# SECURITY
# Firma dei token JWT di sessione merchant. Stringa lunga e casuale.
JWT_SECRET_KEY=

# Protegge gli endpoint amministrativi /api/merchant (header X-Admin-Key) ed è la password della
# dashboard del founder (/admin). Genera con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Non lasciarla vuota: con un valore vuoto l'accesso admin resta comunque chiuso.
ADMIN_SECRET_KEY=

# AUTH
# dev = accesso locale/test, utenti in memoria (l'app NON parte con ENVIRONMENT=production);
# local = email+password con hash scrypt nel nostro DB (tabella AuthCredential): è quello da usare in produzione;
# supabase = stub, rilascio successivo
AUTH_PROVIDER=dev
# development | production
ENVIRONMENT=development
# Solo AUTH_PROVIDER=dev: password di accesso dei merchant creati da scripts.seed_db
# (non è un segreto, serve solo in locale). Vuota = nessun accesso con password dev.
DEV_AUTH_PASSWORD=dev-password

# ECOLOGI (piantumazione alberi) — una sola chiave di piattaforma, paga il founder
# Un solo URL per entrambe le modalità (Ecologi non ha un sandbox: la prova è il flag "test": true)
ECOLOGI_BASE_URL=https://public.ecologi.com
# Chiave REALE (addebita): usata solo con ECOLOGI_TEST_MODE=false
ECOLOGI_API_KEY=
# Chiave di PROVA: usata con ECOLOGI_TEST_MODE=true (in locale/collaudo)
ECOLOGI_TEST_API_KEY=
# true → chiave di test + flag "test" (nessun addebito). Mettere false SOLO in produzione, con ECOLOGI_API_KEY.
ECOLOGI_TEST_MODE=true
# Massimo alberi piantati in una chiusura mensile (oltre, close_period si ferma e chiede)
ECOLOGI_GLOBAL_MONTHLY_CAP=20

# CIFRATURA E SEGRETI (v0.3.0) — OBBLIGATORIE: l'app non parte se mancano o sono malformate.
# Genera ciascuna con: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Chiave AES-256-GCM per chiave Zernio e secret del webhook dei merchant (32 byte in base64 urlsafe)
ENCRYPTION_KEY=
# Id della chiave salvato insieme al dato cifrato (serve alla rotazione futura)
ENCRYPTION_KEY_ID=1
# Indice cieco dell'IGSID dei clienti. NON RUOTABILE: cambiarla scollega tutte le carte dai profili Instagram
IGSID_HMAC_KEY=
# Deriva il token dei link delle carte (/c/<token>). Cambiarla invalida tutti i link inviati
CARD_LINK_KEY=

# INSTAGRAM / ZERNIO (v0.3.0)
# URL pubblico https dell'app: link delle carte e URL del webhook registrato su Zernio.
# In locale: l'URL del tunnel cloudflared (cambia a ogni avvio: poi va rifatto l'onboarding del merchant)
PUBLIC_BASE_URL=http://127.0.0.1:8001
ZERNIO_BASE_URL=https://zernio.com/api
# Solo per gli script di collaudo (scripts.zernio_check): chiave Zernio di prova, letta da questo file
# o dall'ambiente. Opzionale: vuota = lo script la chiede a video. Non serve in produzione
ZERNIO_CHECK_API_KEY=
# Parola chiave che il cliente scrive in DM al negozio (maiuscole, accenti, punteggiatura ed emoji ignorati)
INSTAGRAM_CARD_KEYWORD=CARTA
# Invii gratuiti al mese per team Zernio e soglia di avviso nel pannello del merchant (%)
ZERNIO_MONTHLY_SEND_LIMIT=10000
ZERNIO_SEND_WARN_PERCENT=75

# LIVELLI DEL POOL — soglie di default (punti del mese); l'admin può fare override per negozio
TIER_BRONZE_POINTS=100
TIER_SILVER_POINTS=300
TIER_GOLD_POINTS=600
